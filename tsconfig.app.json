{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/server",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/main.server.ts",
    "src/server.ts",
    "src/**/*.ts",
    "src/app/**/*.ts",
    "src/environments/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "src/test.ts"]
}
